{
  "$schema": "https://schemas.wp.org/wp/7.1/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "paper", "color": "#f7f8f7", "name": "Ruhiges Papier" },
        { "slug": "surface", "color": "#ffffff", "name": "Fläche" },
        { "slug": "ink", "color": "#1d2d3b", "name": "Tiefes Blau" },
        { "slug": "muted", "color": "#5d6c79", "name": "Gedämpft" },
        { "slug": "line", "color": "#d5dee6", "name": "Linie" },
        { "slug": "accent", "color": "#2d6799", "name": "Klares Blau" },
        { "slug": "accent-pale", "color": "#e8f0f7", "name": "Helles Blau" }
      ]
    },
    "layout": {
      "contentSize": "42rem",
      "wideSize": "62rem"
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": ["px", "rem", "%", "vw"]
    },
    "typography": {
      "customFontSize": false,
      "dropCap": false,
      "fontFamilies": [
        {
          "fontFamily": "Georgia, Cambria, 'Times New Roman', serif",
          "name": "Editorial Serif",
          "slug": "editorial-serif"
        },
        {
          "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif",
          "name": "System Sans",
          "slug": "system-sans"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|ink"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|accent"
        },
        "typography": {
          "textDecoration": "underline"
        }
      }
    }
  }
}
